# ==============================================================
# Variáveis de ambiente do backend — UFU MIA
# Copie este arquivo para .env e preencha com valores reais.
# NUNCA commite o arquivo .env!
# ==============================================================

# Chave secreta do Django (gere uma nova com:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=troque-por-uma-chave-secreta-gerada

# Modo debug (False em produção!)
DEBUG=True

# Hosts permitidos (separados por vírgula)
ALLOWED_HOSTS=localhost,127.0.0.1

# Origens permitidas pelo CORS (separados por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Origens confiáveis para CSRF (separados por vírgula)
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# URL do banco de dados (SQLite para dev, PostgreSQL para produção)
DATABASE_URL=sqlite:///db.sqlite3

# URL customizada do painel admin (use algo não óbvio em produção)
ADMIN_URL=admin/

# Cloudinary — armazenamento de imagens (obrigatório em produção)
# Formato: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=cloudinary://000000000000000:xxxxxxxxxxxxxxx@nome-do-cloud
