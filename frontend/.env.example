# Copie este arquivo para ".env" (o .env NÃO vai para o GitHub).
# ATENÇÃO: tudo que começa com VITE_ fica PÚBLICO no navegador. Nunca coloque senhas aqui.

# Endereço da API do backend
VITE_API_URL=http://127.0.0.1:8000/api

# Endereço do painel da equipe: o cadeadinho discreto no rodapé do site leva até ele.
# Em produção use o endereço do backend + ADMIN_URL, ex.: https://ufumia-api.onrender.com/painel-x7k2q/
# Se ficar em branco, o cadeadinho não aparece.
VITE_ADMIN_URL=http://localhost:8000/admin/
